# Authentication method: 'oauth' (default) or 'github-app'
# oauth = GitHub OAuth App (broad 'repo' scope, no app installation needed per org)
# github-app = GitHub App (granular read-only permissions, must be installed per org)
AUTH_METHOD=oauth

# GitHub OAuth App credentials (used when AUTH_METHOD=oauth)
# Register at: https://github.com/settings/applications/new
# Set "Authorization callback URL" to your dashboard URL (e.g., https://yourdomain.com/)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App credentials (used when AUTH_METHOD=github-app)
# Register at: https://github.com/settings/apps/new
# Required permissions: Actions (read), Metadata (read), Organization Members (read)
# Set "Callback URL" to your dashboard URL (e.g., https://yourdomain.com/)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ────────── Teams notifier (optional) ──────────
# When all three vars below are set, the server polls GitHub every 30s and
# posts a Teams notification for newly-started workflow runs in MONITORED_REPOS.
# Configure the actual Teams webhook URL via the dashboard's Settings modal.

# Personal Access Token used by the server-side polling (independent of users in the UI).
# Required scopes: `repo` (or `actions:read` + `metadata:read` for fine-grained PATs).
GITHUB_TOKEN=

# Comma-separated list of repos to watch, in `owner/repo` form.
# Example: MONITORED_REPOS=DEAPCZ/call-app-frontend,DEAPCZ/other-repo
# When LEFT EMPTY, the server auto-discovers all repos the token has access to
# (personal repos + every org the user belongs to). The list is refreshed every
# 10 minutes. Watch the rate limit if the token has access to many repos —
# each repo costs ≥1 GitHub API call per 30s polling cycle.
MONITORED_REPOS=

# Public URL of the dashboard, used as the "Open in dashboard" link in Teams messages.
# Example: DASHBOARD_URL=https://githubactions.savingstech.cz
DASHBOARD_URL=

# Optional override for the notifier config file path. Defaults to `./notifier-config.json`
# in the server's working directory. Set to a volume-mounted path if the working dir is ephemeral.
# NOTIFIER_CONFIG_PATH=/var/lib/ghactions-api/notifier-config.json
